# Force built-in for Amlogic GXL hardware required by the initramfs image
# (the arm64 arch default config compiles several of these as modules, which
# cannot be loaded from an initramfs that has no on-disk module tree)
CONFIG_SERIAL_MESON=y
CONFIG_SERIAL_MESON_CONSOLE=y
CONFIG_MMC_MESON_GX=y
CONFIG_SPI_MESON_SPICC=y
CONFIG_SPI_SPIDEV=y
CONFIG_HW_RANDOM_MESON=y

# Disable networking (non-dev production build - SeedSigner is air-gapped)
# CONFIG_INET is not set
# CONFIG_IPV6 is not set
# CONFIG_NETDEVICES is not set
# CONFIG_PACKET is not set
# CONFIG_STMMAC_ETH is not set
# CONFIG_DWMAC_MESON is not set
# CONFIG_MDIO_BUS_MUX_MESON_GXL is not set
# CONFIG_PHYLIB is not set
# CONFIG_MESON_GXL_PHY is not set

# Disable display/HDMI output (SeedSigner uses external SPI LCD only)
# CONFIG_DRM is not set
# CONFIG_FRAMEBUFFER_CONSOLE is not set
# CONFIG_FB is not set
