#!/bin/sh
#
# S10mdev - Register mdev as the kernel hotplug handler
#
# Enables automatic FAT filesystem repair + mounting for block devices (MicroSD
# cards, USB drives), whether inserted after boot or already present at power-on.
# mdev intercepts kernel hotplug events and runs /usr/sbin/fat-fsck-hotplug for
# each new block partition; a coldplug pass re-triggers the uevents of partitions
# that existed before registration so a power-on card is handled too (see start()).
#
# Runs after S02fsck (which fscks partitions present at boot) so that both
# boot-time and hot-inserted storage devices are covered.
#

start() {
    if ! command -v mdev >/dev/null 2>&1; then
        echo "[mdev] mdev not found; hotplug filesystem checks disabled"
        return 0
    fi

    if [ ! -f /etc/mdev.conf ]; then
        echo "[mdev] /etc/mdev.conf not found; skipping"
        return 0
    fi

    # Register mdev as the kernel hotplug handler.
    # This causes the kernel to invoke /sbin/mdev for every device event,
    # which reads /etc/mdev.conf and runs the configured commands.
    if [ -w /proc/sys/kernel/hotplug ]; then
        echo /sbin/mdev > /proc/sys/kernel/hotplug
        echo "[mdev] Hotplug handler registered (/proc/sys/kernel/hotplug)"
    else
        echo "[mdev] WARNING: /proc/sys/kernel/hotplug not writable; hotplug events may not be received"
        return 0
    fi

    # Coldplug pass. Block devices probed before we registered - a card already
    # inserted at power-on is the case that matters - emitted their "add" uevent
    # while /proc/sys/kernel/hotplug was still empty, so it went to dmesg only and
    # nothing will ever re-emit it. Re-trigger each existing partition's uevent:
    # the kernel redelivers it as ACTION=add through the handler we just wrote,
    # so fat-fsck-hotplug treats a power-on card exactly like a hot-inserted one.
    # Non-FAT partitions (the eMMC/NAND root chain) exit immediately inside the
    # helper, which is why this can run unconditionally. The events are handled
    # asynchronously; by the time S99seedsigner starts the app, any FAT card is
    # mounted at /mnt/microsd.
    local sysdev
    for sysdev in /sys/class/block/mmcblk[0-9]p* /sys/class/block/sd*; do
        [ -e "$sysdev/uevent" ] || continue
        echo add > "$sysdev/uevent" 2>/dev/null || true
    done
}

stop() {
    # Unregister mdev as hotplug handler
    if [ -w /proc/sys/kernel/hotplug ]; then
        echo "" > /proc/sys/kernel/hotplug
    fi
}

case "$1" in
    start)
        start
        ;;
    stop)
        stop
        ;;
    restart|reload)
        stop
        start
        ;;
    *)
        echo "Usage: $0 {start|stop|restart}"
        exit 1
        ;;
esac

exit 0
