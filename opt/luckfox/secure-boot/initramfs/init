#!/bin/sh
# SeedSigner rootfs verification initramfs — Luckfox Pico (NAND, MicroSD, eMMC).
#
# Runs from RAM (packed into the signed boot.img FIT ramdisk slot) before
# pivot_root. It reads root= off /proc/cmdline and streams that device's bytes
# through minisign's pre-hashed verifier, which checks them against the
# signature produced over the exact .ubifs/.squashfs file at build time —
# without ever materialising the image in RAM (peak ~128 KiB) — and only then
# mounts and switches (switch_root) to the real rootfs. Per medium:
#   NAND non-dev : squashfs on a static UBI volume, /dev/ubiblock0_0
#                  (ubi.block=0,rootfs + ubi.mtd=5 baked into the signed DTB)
#   NAND dev     : writable dynamic UBIFS volume, logical contents at /dev/ubi0_0
#   MicroSD/eMMC : raw-partition squashfs, root=/dev/mmcblk1p6 (mini/max SD) or
#                  /dev/mmcblk0p6 (pi eMMC — it is the first block device); the
#                  SDK writes the signed file verbatim to partition offset 0 and
#                  the rest of the partition is untrusted padding this script
#                  never reads
#
# Everything here is signed (boot.img FIT) or pinned by it: a modified
# rootfs cannot change what this script checks, because the script, the
# public key and the signature all live in RAM, not on the untrusted volume.
#
# Failure policy: show FAIL on the LCD, log to the console, halt (no reboot
# loop). The device is recovered by power-cycling; a board fused with secure
# boot will keep refusing to start until a correctly signed image is flashed.

export PATH=/bin:/sbin:/usr/bin:/usr/sbin
export HOME=/

# Byte size of the signed rootfs image (substituted at build time from the
# signing hook's .size output). The volume/partition is padded beyond it, so
# the streaming read below must stop at exactly this many bytes.
ROOTFS_SIGNED_SIZE=__ROOTFS_SIGNED_SIZE__
# Name of the GPIO-HAT key wired to GPIO1_C7 on this board (substituted at
# build time): mini=KEY_DOWN, max=KEY1, pi=KEY3. See the verification-failure
# escape hatch below.
WAITKEY_KEY_NAME=__WAITKEY_KEY_NAME__
# Per-board display control pins for ss-lcd (substituted at build time; match
# io_config.json's 'display' section — DC and RST may sit on different chips).
export SS_LCD_DC_CHIP="__LCD_DC_CHIP__"
export SS_LCD_DC_LINE="__LCD_DC_LINE__"
export SS_LCD_RST_CHIP="__LCD_RST_CHIP__"
export SS_LCD_RST_LINE="__LCD_RST_LINE__"
# Backlight (max/pi only; the Mini panel has none, so this substitutes empty):
# the pin idles LOW at boot and ss-lcd must light it for its frames to show.
if [ -n "__LCD_BL_CHIP__" ]; then
    export SS_LCD_BL_CHIP="__LCD_BL_CHIP__"
    export SS_LCD_BL_LINE="__LCD_BL_LINE__"
fi
# Key class of this image's two signatures (substituted at build time from the
# ACTUAL key bytes — see embed_rootfs_verifier): "dev" = the committed PUBLIC
# dev key, which grants no protection; anything else is a real secret key.
# Shown on the pass screen only when verification actually ran (fused boards).
FIT_KEY_CLASS=__FIT_KEY_CLASS__
ROOTFS_KEY_CLASS=__ROOTFS_KEY_CLASS__

log() { echo "rootfs-verify: $*"; }

# Best effort, never fatal: a status screen must not become a second failure
# mode (same contract as files/show-screen-message.py).
lcd() { /bin/ss-lcd "$@" 2>/dev/null || true; }

fail() {
    log "FAIL: $1"
    dmesg | tail -n 30
    # Fixed layout (no arbitrary-length reasons on the LCD — they overflow;
    # the actual reason is on the UART log above). Generic wording: fail()
    # covers cmdline/UBI/mount/GPIO errors, not just signature failures.
    lcd red FAILED boot halted "" HALTING
    # Halt, do not reboot: a reboot would just loop back here. The kernel
    # stays up (CPUs stop after userspace exits), so the board is recoverable
    # by power-cycle and nothing keeps writing to the NAND.
    # -f is REQUIRED: plain `halt` signals PID 1 (itself) with SIGUSR1, which
    # the kernel silently ignores for init — kill() returns success and this
    # function would RETURN, letting /init continue past a failed check.
    halt -f 2>/dev/null || { log "halt failed, spinning"; while :; do sleep 3600; done; }
}

# --- basic filesystems -------------------------------------------------------
mount -t proc proc /proc 2>/dev/null || log "WARN: mounting /proc failed"
mount -t sysfs sysfs /sys 2>/dev/null || log "WARN: mounting /sys failed"

# --- determine how the real root is presented ---------------------------------
# NAND non-dev (read-only): squashfs on a static UBI volume exposed as a block device
#     bootargs: ubi.block=0,rootfs root=/dev/ubiblock0_0 rootfstype=squashfs
# NAND dev (writable): raw dynamic UBIFS volume
#     bootargs: root=ubi0:rootfs rootfstype=ubifs
# MicroSD/eMMC (read-only): squashfs written verbatim to a plain partition
#     bootargs: root=/dev/mmcblk{0,1}p6 rootfstype=squashfs  (eMMC=mmcblk0)
ROOT_DEV=""
for w in $(cat /proc/cmdline); do
    case "$w" in
        root=*) ROOT_DEV="${w#root=}" ;;
    esac
done
if [ -z "$ROOT_DEV" ]; then
    if [ ! -r /proc/cmdline ]; then
        fail "cannot read kernel command line (/proc not mounted?)"
    fi
    fail "no root= on kernel command line"
fi
log "cmdline: root=$ROOT_DEV"

case "$ROOT_DEV" in
    /dev/ubiblock*)
        SRC_DEV="$ROOT_DEV"
        MNT_CMD="mount -t squashfs -o ro $ROOT_DEV /mnt"
        ;;
    ubi0:*)
        # UBI auto-attach (ubi.mtd=5) exposes the volume's logical contents.
        # Mount by volume NUMBER (ubi0_0), never by the name on the command
        # line: the bytes hashed below come from volume 0, and `ubi0:rootfs`
        # resolves by NAME — a crafted UBI image could carry the genuine
        # image as volume 0 under another name and a second volume called
        # "rootfs", so the verifier would check one volume and mount the
        # other. Same volume in, same volume mounted.
        SRC_DEV="/dev/ubi0_0"
        MNT_CMD="mount -t ubifs ubi0_0 /mnt"
        ;;
    /dev/mmcblk*)
        # MicroSD/eMMC: the signed squashfs file starts at partition offset 0;
        # everything after ROOTFS_SIGNED_SIZE bytes is untrusted padding.
        SRC_DEV="$ROOT_DEV"
        MNT_CMD="mount -t squashfs -o ro $ROOT_DEV /mnt"
        ;;
    *)
        fail "unsupported root= ($ROOT_DEV) — expected /dev/ubiblock*, ubi0:* or /dev/mmcblk*"
        ;;
esac

# NB: /dev/ubi0_0 is a CHARACTER device (c 10 69), not a block one — test
# existence, never -b. (/dev/ubiblock0_0 and /dev/mmcblk* ARE block devs;
# -e covers all of them.)
if [ ! -d /dev/ubi_ctrl ] && [ ! -e "$SRC_DEV" ]; then
    mount -t devtmpfs devtmpfs /dev 2>/dev/null \
        || { mknod -m 660 /dev/ubi_ctrl c 10 58 2>/dev/null; log "WARN: manual /dev setup"; }
fi

# --- wait for the root device to appear ---------------------------------------
# UBI auto-attach (NAND) and MMC probe (MicroSD/eMMC) both complete shortly
# after boot; poll rather than assume an order.
log "waiting for $SRC_DEV ..."
tries=0
while [ ! -e "$SRC_DEV" ] && [ $tries -lt 50 ]; do
    sleep 1
    tries=$((tries + 1))
done
[ -e "$SRC_DEV" ] || fail "root device never appeared ($SRC_DEV)"
log "$SRC_DEV present after ${tries}s"

# This SDK kernel's devtmpfs does NOT create the magic symlinks mainline has
# (/dev/stdin -> /proc/self/fd/0, ...); minisign needs /dev/stdin for its
# -m /dev/stdin streaming input. Create them now that /dev is in its final
# state (the kernel's devtmpfs auto-mount already happened before we ran).
ln -sf /proc/self/fd/0 /dev/stdin 2>/dev/null || true
ln -sf /proc/self/fd/1 /dev/stdout 2>/dev/null || true
ln -sf /proc/self/fd/2 /dev/stderr 2>/dev/null || true

# --- secure-boot fuse check ---------------------------------------------------
# VERIFY BY DEFAULT. The only thing that skips verification is an explicit
# `fuse.programmed=0` on the kernel command line with no `fuse.programmed=1`
# anywhere — the rule docs/luckfox/secure-boot.md §5.2 states.
#
# The flag is the preloader's verdict: the BootROM reads the SoC's secure-boot
# OTP fuses and passes the result to U-Boot via ATAG_PUB_KEY; full U-Boot —
# itself signature-verified on fused boards before any of this runs — appends
# fuse.programmed=1/0 (param_parse_pubkey_fuse_programmed(),
# arch/arm/mach-rockchip/param.c). It is emitted only from the ROM atag, never
# from env, and since the env partition contributes nothing to a signed build's
# command line (lock-kernel-cmdline.sh), an attacker who can write the env
# cannot forge either value. Bench rows G5/G8 show it on MicroSD as well as NAND.
#
# NO FLAG AT ALL (no atag — a different preloader/U-Boot) is UNKNOWN, and
# unknown verifies. It must never fall through to "unfused": checking when
# unneeded costs a few seconds, skipping on a locked board defeats the feature.
#
# The nvmem OTP byte is NOT a fuse detector and must never be able to turn
# verification OFF. /sys/bus/nvmem/devices/rockchip-otp0/nvmem is the
# NON-secure OTP view: offset 0x80 reads the chip ID on fused and unfused boards
# alike (secure-boot.md §4.5, bench row E4 — where trusting it made a FUSED
# board skip verification). It is kept only as a one-way signal: if it ever
# does read 0xff it can force verification on, nothing more. The blob is raw
# binary — ash cannot hold it in a variable — so hash the one byte and compare.
SECURE_BOOT_FUSED=1
FUSE_VERDICT=unknown
cmdline=$(cat /proc/cmdline 2>/dev/null)
for w in $cmdline; do
    case "$w" in
        fuse.programmed=1) FUSE_VERDICT=fused ;;
        fuse.programmed=0) [ "$FUSE_VERDICT" = fused ] || FUSE_VERDICT=unfused ;;
    esac
done
if [ "$FUSE_VERDICT" = unfused ]; then
    SECURE_BOOT_FUSED=0
    otp_byte_hash=$(dd if=/sys/bus/nvmem/devices/rockchip-otp0/nvmem bs=1 skip=128 count=1 2>/dev/null | sha256sum)
    otp_byte_hash=${otp_byte_hash%% *}
    if [ "$otp_byte_hash" = a8100ae6aa1940d0b663bb31cd466142ebbdbd5187131b92d93818987832eb89 ]; then
        SECURE_BOOT_FUSED=1      # byte == 0xff: force verification on
        FUSE_VERDICT=fused
    fi
fi
[ "$FUSE_VERDICT" = unknown ] && log "no fuse.programmed flag on the command line — fuse state unknown, verifying"

# --- forced verification on unfused boards -----------------------------------
# A /force-rootfs-verify file in this initramfs makes an UNFUSED board verify
# the rootfs anyway. It is added by the build flag
# SEEDSIGNER_ROOTFS_VERIFY_UNFUSED=1, or later by the SeedSigner "Luckfox Build
# Tools" (which re-sign boot.img to do it). A marker file rather than a baked-in
# value, so a tool can set or clear it without editing this script.
#
# It is harmless and gives NO real protection: without the fuse, nothing checks
# this initramfs either, so anyone able to replace the rootfs can replace the
# checker too. What it does give is proof the image is intact, and a way to
# exercise the verifier before a board is ever fused.
FORCED_VERIFY=0
if [ "$SECURE_BOOT_FUSED" = 0 ] && [ -e /force-rootfs-verify ]; then
    FORCED_VERIFY=1
    log "secure boot NOT fused, but /force-rootfs-verify is present — verifying the rootfs anyway"
fi

# --- verify the signature ----------------------------------------------------
if [ "$SECURE_BOOT_FUSED" = 0 ] && [ "$FORCED_VERIFY" = 0 ]; then
    log "secure boot NOT fused (fuse.programmed=0 on cmdline) — skipping rootfs verification"
    lcd orange SHIELDSIGNER SECURE BOOT not enabled "" BOOTING
    # Hold so a human can actually read it: without this, mount + switch_root
    # take over the panel in ~2 s and the warning is invisible.
    sleep 5
else
# Stream exactly ROOTFS_SIGNED_SIZE bytes from the volume/partition straight
# into minisign, which BLAKE2b-512s its input in 64 KiB chunks (the -H/
# pre-hashed mode is recorded inside /rootfs.sig itself — sig_alg "ED" — so no
# flag is needed here). Peak RAM is ~128 KiB regardless of rootfs size, which
# is what makes this work for the 93 MiB NAND volume and the multi-GB MicroSD
# partition alike. Only the signed prefix is read: UBI autoresize pads the
# volume (NAND) / the partition tail is zero-filled (MicroSD/eMMC), both
# untrusted and irrelevant. A short/failed dd yields fewer bytes -> hash
# mismatch -> fail-closed, same as a tampered rootfs.
lcd orange SHIELDSIGNER Verifying rootfs Signature
log "verifying minisign signature (streaming $ROOTFS_SIGNED_SIZE bytes) ..."
# dd reads ceil(SIZE/4096) blocks — at most one block of padding beyond the
# signed prefix — and head -c trims the stream to exactly SIZE bytes. No
# byte-at-a-time tail read, no temp file, O(1) RAM end to end.
UNVERIFIED=0
blocks=$(( (ROOTFS_SIGNED_SIZE + 4095) / 4096 ))
if ! dd if="$SRC_DEV" bs=4096 count=$blocks 2>/dev/null \
     | head -c "$ROOTFS_SIGNED_SIZE" \
     | /bin/minisign -V -p /pubkey -x /rootfs.sig -m /dev/stdin; then
    log "FAIL: rootfs verification failed (bad signature or read error)"
    dmesg | tail -n 30
    # Escape hatch: a person with physical access can press the GPIO-HAT key
    # to boot an UNVERIFIED rootfs. The pin is GPIO1_C7 — wired to a button on
    # every Luckfox variant (KEY_DOWN on Mini, KEY1 on Pro Max, KEY3 on Pico
    # Pi), so one baked-in program works for all three boards; only the label
    # shown differs (__WAITKEY_KEY_NAME__, substituted at build time). The four
    # register writes are the same IOMUX/pull-up/direction/IE sequence that
    # /usr/bin/configure-gpio.sh applies before each app launch — required,
    # because the RV1106 pinctrl driver silently ignores gpiolib bias flags.
    # "press KEY_DOWN" is 14 chars — the max that fits a body line at 2x.
    lcd red FAILED rootfs signature mismatch "" "press $WAITKEY_KEY_NAME"
    if ! /bin/ss-lcd waitkey /dev/gpiochip1 23 \
         0xFF538014 0x70000000 0xFF5381C8 0xC0004000 \
         0xFF53000C 0x00800000 0xFF538188 0x00800080; then
        fail "cannot access HAT key (GPIO)"
    fi
    log "WARN: $WAITKEY_KEY_NAME pressed — continuing with UNVERIFIED rootfs"
    lcd green BOOTING
    UNVERIFIED=1
else
    log "signature OK"
fi
fi

# --- mount and hand over -----------------------------------------------------
if [ "$FORCED_VERIFY" = 1 ] && [ "${UNVERIFIED:-0}" = 0 ]; then
    # Verified, but on an unfused board: integrity, not authenticity. Say so
    # plainly, in orange, and hold it long enough to read - the same way the
    # plain "not enabled" screen does - so it is never mistaken for green.
    log "signature OK on an UNFUSED board (forced) — secure boot is not enabled"
    lcd orange PASSED "rootfs valid" "SECURE BOOT" "not enabled" "" BOOTING
    sleep 5
elif [ "$FUSE_VERDICT" = unknown ] && [ "${UNVERIFIED:-0}" = 0 ]; then
    # Verified, but nothing told us whether this board is fused: integrity is
    # proven, enforcement is not. Never the green screen.
    log "signature OK, but the fuse state is unknown (no fuse.programmed flag)"
    lcd orange PASSED "rootfs valid" "fuse state" "unknown" "" BOOTING
    sleep 5
elif [ "$SECURE_BOOT_FUSED" = 1 ] && [ "${UNVERIFIED:-0}" = 0 ]; then
    if [ "$FIT_KEY_CLASS" = "dev" ] || [ "$ROOTFS_KEY_CLASS" = "dev" ]; then
        # Verified, but at least one signature was made with the committed
        # PUBLIC dev key — that grants no protection, so say so on the panel
        # (yellow instead of green) and name which signature is affected.
        log "signature OK (FIT key: $FIT_KEY_CLASS, rootfs key: $ROOTFS_KEY_CLASS — dev key in use, NO protection)"
        lcd yellow PASSED "FIT: $FIT_KEY_CLASS" "rootfs: $ROOTFS_KEY_CLASS" BOOTING
    else
        lcd green PASSED rootfs signature valid "" BOOTING
    fi
fi
log "mounting rootfs ($MNT_CMD) ..."
if ! $MNT_CMD; then
    fail "cannot mount rootfs"
fi

# switch_root moves this mount over / — everything mounted on the OLD root
# (the kernel's devtmpfs auto-mounted at our /dev, plus /proc and /sys) becomes
# unreachable from the new one. Bind them onto the new root so it inherits live
# kernel filesystems: without /dev there are no gpiochip/i2c/video nodes and
# the app cannot start (Buildroot relies on devtmpfs auto-population —
# BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_DEVTMPFS — so nothing else creates them).
mount --bind /dev  /mnt/dev  || fail "cannot bind-mount /dev"
mount --bind /proc /mnt/proc || mount -t proc proc /mnt/proc \
    || fail "cannot provide /proc to new root"
mount --bind /sys  /mnt/sys  || mount -t sysfs sysfs /mnt/sys \
    || fail "cannot provide /sys to new root"

cd /mnt || fail "cannot cd /mnt"
# The initramfs is the kernel's rootfs pseudo-filesystem, and pivot_root()
# refuses to work from it (EINVAL — see Documentation/filesystems/ramfs-rootfs-
# initramfs.rst: "you can neither pivot_root rootfs, nor unmount it").
# switch_root does the documented handoff: deletes the old initramfs contents
# (freeing its RAM), moves this mount over /, chroots in and execs the new
# init. It requires PID 1, a regular /init in the old root and a ramfs/tmpfs
# root — all true here by construction.
log "verified boot complete, handing over to /sbin/init"
# NB: test with a path relative to cwd (/mnt) — fs->root still points at the
# old initramfs until switch_root's chroot, so absolute paths would resolve
# there (and find nothing).
if [ -x sbin/init ]; then
    exec switch_root . /sbin/init
fi
exec switch_root . /bin/sh
