# Options for mdnsd (see /etc/init.d/S50mdnsd).
#
# -H seedsigner  advertise the hostname "seedsigner" -> ssh root@seedsigner.local
#                The system hostname is "seedsigner-dev" (the release image uses
#                "seedsigner-os"), so without -H mdnsd would derive its advertised
#                name from the hostname and answer to seedsigner-dev.local instead.
#                The flag pins the shorter name so the ssh target is the same on
#                dev and release images.
#                mdnsd announces on every multicast interface and re-checks
#                addresses every 10s, so it follows whatever IP the USB relay /
#                wifi / ethernet link gets from DHCP.
MDNSD_ARGS="-H seedsigner"
