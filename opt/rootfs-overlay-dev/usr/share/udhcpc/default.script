#!/bin/sh
RESOLV_CONF="/etc/resolv.conf"

case "$1" in
    deconfig)
        ip addr flush dev $interface
        ;;
    renew|bound)
        ip addr flush dev $interface
        ip addr add $ip/$mask dev $interface
        if [ -n "$router" ]; then
            ip route add default via $router dev $interface
        fi
        echo -n > $RESOLV_CONF
        for ns in $dns; do
            echo "nameserver $ns" >> $RESOLV_CONF
        done
        ;;
    *)
        echo "unknown udhcpc action: $1" >&2
        ;;
 esac

# Run the hooks in default.script.d/ (e.g. 50-mdnsd, which re-announces
# seedsigner.local once a lease arrives), as busybox's stock script does.
for hook in "${0}.d/"*; do
    [ -f "${hook}" ] && [ -x "${hook}" ] || continue
    "${hook}" "${1}"
done
