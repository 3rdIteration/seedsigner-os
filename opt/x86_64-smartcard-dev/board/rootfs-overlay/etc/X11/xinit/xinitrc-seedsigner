#!/bin/sh
# X session for the SeedSigner desktop UI: no window manager -- SDL2 takes
# input focus itself -- just the app rendering the 240x240 UI (scaled) onto
# the root window. stdout/stderr go to /tmp/seedsigner-app.log so app output
# cannot scribble over the display; tail it over ssh on dev builds.

if [ -z "$SS_APP_DIR" ]; then
    SS_APP_DIR="/opt/src"
fi

export SDL_VIDEODRIVER=x11
export SDL_AUDIODRIVER=alsa

cd "$SS_APP_DIR" || exit 1
echo "$(date) starting SeedSigner desktop UI from $SS_APP_DIR" >> /tmp/seedsigner-app.log
exec /usr/bin/python3 main.py >> /tmp/seedsigner-app.log 2>&1
